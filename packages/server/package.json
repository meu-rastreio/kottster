{
  "name": "@kottster/server",
  "version": "3.5.1",
  "description": "Instant admin panel for your project",
  "keywords": [
    "admin",
    "panel",
    "dashboard",
    "no-code",
    "low-code",
    "builder",
    "generate",
    "crud"
  ],
  "main": "dist/index.js",
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "pnpm run clean && tsc",
    "prepack": "pnpm run build",
    "lint": "npx eslint ./lib",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "prepare": "husky",
    "prepare-npm-package": "pnpm add @kottster/common@latest && pnpm run generate-version && rimraf package-lock.json && pnpm run lint --fix && pnpm run build",
    "generate-version": "echo \"export const VERSION = '$npm_package_version';\" > lib/version.ts",
    "docs:generate": "typedoc"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "chalk": "^4.1.2",
    "cookie": "^1.1.1",
    "cross-spawn": "^7.0.6",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "jose": "^5.10.0",
    "knex": "^3.3.0",
    "postgres-array": "^3.0.4",
    "randomstring": "^1.3.2",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@kottster/common": "^3.5.1",
    "@trpc/server": "^10.45.4",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.2",
    "babel-jest": "^29.7.0",
    "better-sqlite3": "^13.0.3",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "mock-fs": "^5.5.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "synp": "^1.9.14",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^7.18.0",
    "vite": "^6.4.5"
  },
  "peerDependencies": {
    "@kottster/common": "^3.x",
    "better-sqlite3": "^12.x || ^13.x",
    "vite": "^6.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kottster/kottster.git"
  },
  "bugs": {
    "url": "https://github.com/kottster/kottster/issues"
  },
  "homepage": "https://kottster.app/",
  "packageManager": "pnpm@9.10.0+sha512.73a29afa36a0d092ece5271de5177ecbf8318d454ecd701343131b8ebc0c1a91c487da46ab77c8e596d6acf1461e3594ced4becedf8921b074fbd8653ed7051c",
  "pnpm": {
    "overrides": {
      "lodash": "^4.18.1"
    }
  }
}
