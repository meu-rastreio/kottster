    "nodemon": "^3.1.14",
    "portfinder": "^1.0.38",
    "sync-fetch": "^0.5.2"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.11",
    "@babel/traverse": "^7.29.10",
    "@babel/types": "^7.29.11",
    "@eslint/js": "^9.39.5",
