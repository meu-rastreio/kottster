    "jest": "^29.7.0",
    "mock-fs": "^5.5.0",
    "rimraf": "^5.0.10",
    "supertest": "^7.3.1",
    "synp": "^1.9.14",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
