{
  "name": "@kottster/cli",
  "version": "3.5.1",
  "description": "CLI for Kottster",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "pnpm run clean && tsc",
    "prepack": "pnpm run build",
    "lint": "npx eslint ./cli",
    "test": "jest --coverage",
    "prepare": "husky",
    "prepare-npm-package": "pnpm add @kottster/common@latest && pnpm run generate-version && rimraf package-lock.json && pnpm run lint --fix && pnpm run build",
    "generate-version": "echo \"export const VERSION = '$npm_package_version';\" > cli/version.ts"
  },
  "bin": {
    "kottster": "dist/index.js"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "cross-spawn": "^7.0.6",
